---
import "../styles/global.css";

const { title, description } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: "/", label: "Home" },
  { href: "/work-experience/", label: "Work Experience" },
  { href: "/projects/", label: "Projects" },
  { href: "/cv-background/", label: "CV & Background" }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <nav class="glass-nav" aria-label="Primary">
      {nav.map((item) => (
        <a href={item.href} data-active={path === item.href} class="glass-link">{item.label}</a>
      ))}
    </nav>

    <main class="shell">
      <slot />
    </main>
  </body>
</html>
