---
import BaseLayout from "../layouts/BaseLayout.astro";
import KatexBlock from "../components/KatexBlock.astro";
---

<BaseLayout
  title="Research & Experience | Maitri Shah"
  description="Multi-hop radioactivity timeline and research pipeline contributions at CISPA SprintML."
>
  <header>
    <p class="bento-kicker">Page 2 | Research & Experience</p>
    <h1 class="page-title">Collaborative Research Pipeline</h1>
    <p class="page-subtitle">
      Contributed to watermark radioactivity analysis, integrated the <span class="metric">SANA 0.6B</span> backend,
      and developed as part of a team teaching materials for secure ML methods.
    </p>
  </header>

  <section class="section glass-card">
    <h2>Research Assistant | CISPA SprintML Lab</h2>
    <ul class="clean">
      <li>Contributed to evaluation of <span class="metric">Infinity-2B</span> and <span class="metric">SD2.1</span> across multi-hop fine-tuning.</li>
      <li>Developed as part of a team the backend integration of <span class="metric">SANA 0.6B</span> into a shared research pipeline.</li>
      <li>Contributed to Welch t-test based persistence analysis under supervised and unsupervised settings.</li>
    </ul>

    <KatexBlock expression={'t = \\frac{\\bar{x}_1 - \\bar{x}_2}{\\sqrt{\\frac{s_1^2}{n_1}+\\frac{s_2^2}{n_2}}},\\quad p < 0.05 \\Rightarrow \\text{detectable persistence}'} />

    <div class="timeline-wrap">
      <p class="bento-kicker">Infinity-2B Multi-Hop Timeline</p>
      <div class="timeline-nodes" role="tablist" aria-label="Hop timeline">
        <button class="timeline-node active" data-hop="1" type="button">Hop 1</button>
        <button class="timeline-node" data-hop="2" type="button">Hop 2</button>
      </div>
      <article class="meta-card">
        <p id="hop-title" class="metric">Hop 1 | Early Persistence</p>
        <p id="hop-stats">p-value: 0.012 | ROC AUC: 0.89 | TPR @ 1% FPR: 0.74</p>
        <svg id="hop-roc" viewBox="0 0 220 120" width="100%" height="120" aria-label="ROC Curve">
          <line x1="16" y1="104" x2="206" y2="104" stroke="rgba(255,255,255,0.22)" />
          <line x1="16" y1="104" x2="16" y2="12" stroke="rgba(255,255,255,0.22)" />
          <path id="roc-path" d="M16 104 C45 80, 62 56, 106 36 C145 22, 172 17, 206 14" stroke="#00f2ff" stroke-width="3" fill="none" />
        </svg>
      </article>
    </div>
  </section>

  <hr class="soft" />

  <section class="section glass-card">
    <h2>Pedagogical Leadership</h2>
    <ul class="clean">
      <li>Developed as part of a team tutorials for <span class="metric">50+ Master’s students</span> on clusters and baseline adversarial methods.</li>
      <li>Contributed to assignment design on Membership Inference Attacks and adversarial robustness.</li>
    </ul>
  </section>

  <script>
    const data = {
      1: {
        title: "Hop 1 | Early Persistence",
        stats: "p-value: 0.012 | ROC AUC: 0.89 | TPR @ 1% FPR: 0.74",
        path: "M16 104 C45 80, 62 56, 106 36 C145 22, 172 17, 206 14"
      },
      2: {
        title: "Hop 2 | Partial Decay",
        stats: "p-value: 0.041 | ROC AUC: 0.81 | TPR @ 1% FPR: 0.63",
        path: "M16 104 C40 90, 63 72, 105 52 C144 35, 171 28, 206 24"
      }
    };

    const buttons = document.querySelectorAll(".timeline-node");
    const title = document.getElementById("hop-title");
    const stats = document.getElementById("hop-stats");
    const path = document.getElementById("roc-path");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const hop = button.dataset.hop;
        const row = data[hop];

        buttons.forEach((b) => b.classList.remove("active"));
        button.classList.add("active");

        title.textContent = row.title;
        stats.textContent = row.stats;
        path.setAttribute("d", row.path);
      });
    });
  </script>
</BaseLayout>
