---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Maitri Shah | Home"
  description="Research-driven implementation and evaluation of reliable AI systems."
>
  <header class="hero-grid">
    <section class="card">
      <p class="kicker">Home</p>
      <h1 class="page-title">Maitri Shah | Research-driven implementation and evaluation of reliable AI systems.</h1>
      <p class="page-subtitle">
        I am a researcher and developer focused on the intersection of generative AI and security. I specialize in building the
        frameworks that evaluate model reliability and the infrastructure that supports large-scale technical competitions.
      </p>
    </section>

    <figure class="hero-photo">
      <img src="/assets/images/image_bfc924.jpg" alt="Maitri Shah" loading="eager" />
    </figure>
  </header>

  <section class="section">
    <h2>Impact Overview</h2>
    <div class="impact-grid">
      <article class="grid-card">
        <h3>Watermark Radioactivity</h3>
        <p>Contributing to research on signal persistence in generative models for an ICML 2026 submission.</p>
      </article>
      <article class="grid-card">
        <h3>Benchmark Engineering</h3>
        <p>Developing tasks and infrastructure for the European Cybersecurity & AI Hackathon Championship.</p>
      </article>
      <article class="grid-card">
        <h3>Academic Excellence</h3>
        <p>Deutschlandstipendium Scholar with a <span class="metric">3.95/4.0 CGPA</span>.</p>
      </article>
    </div>
  </section>
</BaseLayout>
