---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import heroImage from "../assets/image_bfc924.jpg";
---

<BaseLayout
  title="Maitri Shah | Home"
  description="Research-driven implementation and evaluation of reliable AI systems."
>
  <section class="grid gap-4 md:grid-cols-[1.45fr_0.75fr] md:items-start">
    <article id="hero-text-card" class="glass-card">
      <h1 class="hero-title">Maitri Shah</h1>
      <p class="hero-sub text-xl leading-tight md:text-[2rem]">Research Assistant at CISPA SprintML Lab | M.Sc. Student at Universität des Saarlandes.</p>
      <p class="hero-body">
        I am a researcher and developer focused on the intersection of generative AI and security. I specialize in
        building the frameworks that evaluate model reliability and the infrastructure that supports large-scale
        technical competitions.
      </p>
    </article>

    <aside id="hero-photo-card" class="glass-card self-start border-cyanaccent/40 shadow-neon">
      <div class="h-full w-full overflow-hidden rounded-xl">
        <Image src={heroImage} alt="Maitri Shah" class="h-full w-full object-cover" />
      </div>
    </aside>
  </section>

  <section class="mt-10">
    <h2 class="section-title">Impact Overview</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      <article class="glass-card">
        <p class="tag">Work Experience</p>
        <p class="copy">Contributing to <strong>Watermark Radioactivity</strong> research for NeurIPS 2026 and optimizing algorithmic runtimes for high-dimensional data.</p>
      </article>
      <article class="glass-card">
        <p class="tag">Pedagogical Leadership</p>
        <p class="copy">Co-leading tutorials and infrastructure setup for <span class="metric">100+ Master's students</span> in the Trustworthy ML course at Saarland University/CISPA.</p>
      </article>
      <article class="glass-card">
        <p class="tag">AI Hackathon Championship Development</p>
        <p class="copy">Developing competition tasks and automated data/environment setup workflows for the European Cybersecurity & AI Hackathon Championship.</p>
      </article>
      <article class="glass-card">
        <p class="tag">Academic Excellence</p>
        <p class="copy"><strong>Deutschlandstipendium Scholarship holder, 2025.</strong> National scholarship awarded by the German Federal Ministry of Education and Research to top-performing students based on academic excellence and potential. </p>
      </article>
    </div>
  </section>

  <script>
    const syncHeroHeights = () => {
      const textCard = document.getElementById("hero-text-card");
      const photoCard = document.getElementById("hero-photo-card");
      if (!textCard || !photoCard) return;

      if (window.matchMedia("(min-width: 768px)").matches) {
        photoCard.style.height = `${textCard.offsetHeight}px`;
      } else {
        photoCard.style.height = "";
      }
    };

    window.addEventListener("load", syncHeroHeights);
    window.addEventListener("resize", syncHeroHeights);
    if (document.fonts?.ready) {
      document.fonts.ready.then(syncHeroHeights);
    }
  </script>
</BaseLayout>
