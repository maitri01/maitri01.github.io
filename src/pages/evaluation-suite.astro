---
import BaseLayout from "../layouts/BaseLayout.astro";
import KatexBlock from "../components/KatexBlock.astro";
---

<BaseLayout
  title="Evaluation Suite | Maitri Shah"
  description="Interactive championship-style terminal console for benchmark task and metric simulation."
>
  <header>
    <p class="bento-kicker">Evaluation Suite</p>
    <h1 class="page-title">Championship Benchmark Implementation</h1>
    <p class="page-subtitle">
      Contributed to task implementation for the European trustworthy AI championship and developed as part of a team
      secure participant operations with Jülich HPC automation.
    </p>
  </header>

  <section class="section glass-card">
    <h2>Task and Metric Framework</h2>
    <ul class="clean">
      <li>Contributed to implementation of Image Attribution, Model Tracer, and watermark detection and removal tasks across vision and LLM tracks.</li>
      <li>Developed as part of a team the shared security metric standard <span class="metric metric-purple">TPR @ 1% FPR</span>.</li>
    </ul>
    <KatexBlock expression={'\\operatorname{TPR}@1\\%\\operatorname{FPR}=\\frac{\\operatorname{TP}(\\tau_{0.01})}{\\operatorname{P}}'} />
  </section>

  <section class="section glass-card">
    <h2>Simulated Security Console</h2>
    <div class="task-grid">
      <article class="meta-card">
        <p class="bento-kicker">Command: run model-tracer</p>
        <p>Contributed to lineage and attribution diagnostics under strict false-positive constraints.</p>
        <button class="cli-btn" type="button" data-cmd="run model-tracer">Run</button>
      </article>
      <article class="meta-card">
        <p class="bento-kicker">Command: eval --metric</p>
        <p>Developed as part of a team metric reporting centered on TPR @ 1% FPR across participant submissions.</p>
        <button class="cli-btn" type="button" data-cmd="eval --metric">Run</button>
      </article>
    </div>

    <div class="terminal" aria-live="polite">
      <div class="terminal-head">
        <span class="light red"></span>
        <span class="light yellow"></span>
        <span class="light green"></span>
        <span class="terminal-title">trust-ai console</span>
      </div>
      <pre id="terminal-output" class="terminal-body">$ help
Use commands: run model-tracer | eval --metric</pre>
    </div>
  </section>

  <hr class="soft" />

  <section class="section glass-card">
    <h2>Infrastructure and Support</h2>
    <ul class="clean">
      <li>Developed as part of a team Jülich HPC automation scripts for environment provisioning and dataset access for <span class="metric metric-amber">200+</span> participants.</li>
      <li>Contributed to 24-hour technical support windows for coding issues and cluster access troubleshooting during hackathon sessions.</li>
    </ul>
  </section>

  <script>
    const output = document.getElementById("terminal-output");
    const cmdButtons = document.querySelectorAll("[data-cmd]");

    const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

    const typeText = async (text) => {
      output.textContent = "";
      for (const ch of text) {
        output.textContent += ch;
        await sleep(8);
      }
    };

    const runModelTracer = async () => {
      await typeText("$ run model-tracer\n[scan] loading challenge checkpoint...\n[scan] computing signatures...");
      await sleep(280);
      output.textContent += "\n[result] rar-xxl detected (Conf: 0.96)\n[metric] TPR @ 1% FPR = 0.78";
    };

    const runEvalMetric = async () => {
      const chart = [
        "$ eval --metric",
        "TPR @ 1% FPR",
        "candidate-A | #######..... 0.74",
        "candidate-B | #########... 0.81",
        "candidate-C | ##########.. 0.86"
      ].join("\n");
      await typeText(chart);
    };

    cmdButtons.forEach((button) => {
      button.addEventListener("click", async () => {
        const cmd = button.dataset.cmd;
        if (cmd === "run model-tracer") await runModelTracer();
        if (cmd === "eval --metric") await runEvalMetric();
      });
    });
  </script>
</BaseLayout>
