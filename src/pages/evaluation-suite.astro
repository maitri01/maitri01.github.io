---
import BaseLayout from "../layouts/BaseLayout.astro";
import KatexBlock from "../components/KatexBlock.astro";
---

<BaseLayout
  title="Evaluation Suite | Maitri Shah"
  description="Terminal-style benchmark task explorer for trustworthy AI championship implementation."
>
  <header>
    <p class="bento-kicker">Page 3 | Evaluation Suite</p>
    <h1 class="page-title">Trustworthy AI Championship Benchmarks</h1>
    <p class="page-subtitle">
      Developed as part of a team implementation of attribution and tracing tasks, and contributed to participant onboarding with Jülich cluster automation and live support.
    </p>
  </header>

  <section class="section glass-card">
    <h2>Task Implementation</h2>
    <ul class="clean">
      <li>Contributed to five core tasks: Image Attribution, Model Tracer, and watermark removal and detection for vision and LLM tracks.</li>
      <li>Developed as part of a team security-first scoring with <span class="metric">TPR @ 1% FPR</span>.</li>
    </ul>
    <KatexBlock expression={'\\operatorname{TPR}@1\\%\\operatorname{FPR}=\\frac{\\operatorname{TP}(\\tau_{0.01})}{\\operatorname{P}}'} />
  </section>

  <section class="section glass-card">
    <h2>Terminal Task List</h2>
    <div class="task-grid">
      <article class="meta-card">
        <p class="bento-kicker">Model Tracer</p>
        <p>Contributed to provenance tracing under constrained false-positive budgets.</p>
        <button class="cli-btn" type="button" data-cli="model-tracer">Run CLI</button>
      </article>
      <article class="meta-card">
        <p class="bento-kicker">Image Attribution</p>
        <p>Developed as part of a team attribution checks for generated and transformed image distributions.</p>
        <button class="cli-btn" type="button" data-cli="image-attribution">Run CLI</button>
      </article>
      <article class="meta-card">
        <p class="bento-kicker">Watermark Detection</p>
        <p>Contributed to detection baselines and robustness validation under output perturbations.</p>
        <button class="cli-btn" type="button" data-cli="watermark-detection">Run CLI</button>
      </article>
    </div>

    <div class="terminal" aria-live="polite">
      <div class="terminal-head">championship@trust-ai:~$ task --describe</div>
      <pre id="terminal-output" class="terminal-body">Select a task using the CLI buttons above.</pre>
    </div>
  </section>

  <hr class="soft" />

  <section class="section glass-card">
    <h2>Participant Support & Infrastructure</h2>
    <ul class="clean">
      <li>Developed as part of a team Jülich HPC automation scripts for environment setup and secure dataset access.</li>
      <li>Contributed to 24-hour troubleshooting during hackathon windows for coding failures and cluster access issues.</li>
    </ul>
  </section>

  <script>
    const taskMap = {
      "model-tracer": [
        "$ task run model-tracer",
        "> objective: trace model lineage across altered checkpoints",
        "> evaluation: TPR @ 1% FPR",
        "> note: prioritize stability under out-of-distribution probes"
      ],
      "image-attribution": [
        "$ task run image-attribution",
        "> objective: attribute outputs to source model families",
        "> evaluation: TPR @ 1% FPR",
        "> note: calibrate threshold for heavy-tailed error modes"
      ],
      "watermark-detection": [
        "$ task run watermark-detection",
        "> objective: detect embedded marks after transformation",
        "> evaluation: TPR @ 1% FPR",
        "> note: verify persistence across adversarial edits"
      ]
    };

    const output = document.getElementById("terminal-output");
    const buttons = document.querySelectorAll("[data-cli]");

    const typeLines = async (lines) => {
      output.textContent = "";
      for (const line of lines) {
        for (const char of line) {
          output.textContent += char;
          await new Promise((resolve) => setTimeout(resolve, 12));
        }
        output.textContent += "\n";
      }
    };

    buttons.forEach((button) => {
      button.addEventListener("click", async () => {
        const key = button.dataset.cli;
        await typeLines(taskMap[key] || ["No task description available."]);
      });
    });
  </script>
</BaseLayout>
