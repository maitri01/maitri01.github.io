---
import BaseLayout from "../layouts/BaseLayout.astro";
import KatexBlock from "../components/KatexBlock.astro";
---

<BaseLayout
  title="Implementation Lab | Maitri Shah"
  description="Neon trade-off simulator for OLMo-2 unlearning and optimization projects."
>
  <header>
    <p class="bento-kicker">Page 4 | Implementation Lab</p>
    <h1 class="page-title">Trade-off Simulator and Optimization Notes</h1>
    <p class="page-subtitle">
      Contributed to privacy-utility balancing for OLMo-2 unlearning and developed as part of a team runtime optimization strategies for large-scale Wasserstein computations.
    </p>
  </header>

  <section class="section glass-card">
    <h2>LLM Unlearning Trade-off Simulator (Model 1: GA+KL)</h2>
    <p>
      Developed as part of a team comparative evaluation of <span class="metric">GA+KL</span>,
      <span class="metric">Sequential GA</span>, and <span class="metric">SPUL</span>. Slide toward Privacy to inspect stronger forgetting behavior.
    </p>

    <div class="slider-block">
      <input id="tradeoff-slider" class="range-input" type="range" min="0" max="100" value="0" />
      <div class="mode-strip">
        <span>Utility Mode</span>
        <span id="mode-tag" class="metric">Utility</span>
        <span>Privacy Mode</span>
      </div>

      <div class="stat-row">
        <article class="stat-box">
          <p class="stat-label">MIA AUROC</p>
          <p id="auroc" class="stat-value">0.610</p>
        </article>
        <article class="stat-box">
          <p class="stat-label">PPL (forget)</p>
          <p id="ppl-forget" class="stat-value">6.80</p>
        </article>
        <article class="stat-box">
          <p class="stat-label">PPL (retain)</p>
          <p id="ppl-retain" class="stat-value">7.10</p>
        </article>
      </div>
    </div>

    <KatexBlock expression={'\\mathcal{L} = \\mathcal{L}_{CE}(\\mathcal{D}_r) - \\alpha \\cdot \\mathcal{L}_{CE}(\\mathcal{D}_f) + \\beta \\cdot D_{KL}(\\theta\\|\\theta_0 \\mid \\mathcal{D}_r)'} />
  </section>

  <hr class="soft" />

  <section class="section">
    <h2>Algorithmic Optimization (QuadTransport)</h2>
    <div class="meta-grid">
      <article class="meta-card">
        <p class="bento-kicker">Workstream</p>
        <p>
          Contributed to a Hungarian-algorithm redesign using quad-tree partitioning in Java.
        </p>
      </article>
      <article class="meta-card">
        <p class="bento-kicker">Impact</p>
        <p>
          Developed as part of a team a <span class="metric">~50x runtime reduction</span> from
          <span class="metric">35 minutes</span> to <span class="metric">12 seconds</span>.
        </p>
      </article>
    </div>
  </section>

  <script>
    const slider = document.getElementById("tradeoff-slider");
    const modeTag = document.getElementById("mode-tag");
    const aurocEl = document.getElementById("auroc");
    const forgetEl = document.getElementById("ppl-forget");
    const retainEl = document.getElementById("ppl-retain");

    const lerp = (a, b, t) => a + (b - a) * t;

    const render = (value) => {
      const t = value / 100;
      const auroc = lerp(0.61, 0.529, t);
      const pplForget = lerp(6.8, 9.37, t);
      const pplRetain = lerp(7.1, 7.95, t);

      aurocEl.textContent = auroc.toFixed(3);
      forgetEl.textContent = pplForget.toFixed(2);
      retainEl.textContent = pplRetain.toFixed(2);

      modeTag.textContent = value > 60 ? "Privacy" : value < 40 ? "Utility" : "Balanced";
    };

    if (slider) {
      render(Number(slider.value));
      slider.addEventListener("input", () => render(Number(slider.value)));
    }
  </script>
</BaseLayout>
